# Database
# DEV
# DATABASE_URL="postgresql://eal-dbadmin:3iger4dvent1andE@10.10.12.134:5432/dev-en-hris"

# LOCAL
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/dev-en-hris"

# JWT - IMPORTANT: Generate a strong random secret for production
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# App
PORT=3001
# Port WebSocket yang didengar mesin absen. Bukan port HTTP di atas.
#IP publik server
DEVICE_PUSH_PORT=7788
DEVICE_PUSH_HOST=0.0.0.0
# Sync mengisi kartu dan template yang kosong. Data yang sudah terisi tidak ditimpa dan tidak dihapus.

NODE_ENV=development

# CORS - Comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:3000"

# Default tenant for single-tenant or development mode
DEFAULT_TENANT_ID="dev-tenant-001"

# Logging
LOG_LEVEL="debug"

# Storage - "local" or "s3"
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./uploads"
# AWS_S3_BUCKET=""
# AWS_S3_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Email - Microsoft Graph API (preferred) or SMTP fallback
# If MS_GRAPH_* vars are set, Graph API is used. Otherwise falls back to SMTP.
# If neither is configured, emails are logged to console only.

# Microsoft Graph (client credentials flow — no OAuth consent needed)
# MS_GRAPH_TENANT_ID=""
# MS_GRAPH_CLIENT_ID=""
# MS_GRAPH_CLIENT_SECRET=""
# MS_GRAPH_SENDER_EMAIL="hr@yourcompany.com"

# SMTP fallback - optional
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="HRMS <noreply@yourcompany.com>"

# Redis - set REDIS_ENABLED=true to enable background jobs (BullMQ)
# Without Redis, the app runs fine but background job features are disabled
REDIS_ENABLED=false
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""

# SSO (eal-rbac-api)
SSO_API_BASE_URL="http://localhost:5001"
SSO_SERVICE_API_KEY=""
SSO_SERVICE_APP_KEY="eal-hrms"
SSO_SERVICE_APP_NAME="HRMS"
